{
  "name": "nexo",
  "version": "0.20.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "demo:seed": "tsx scripts/seed-demo-catalog.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "company:create": "tsx --env-file=.env scripts/create-company.ts",
    "commercial:record": "tsx --env-file=.env scripts/commercial.ts record",
    "company:onboard": "tsx --env-file=.env scripts/commercial.ts onboard new",
    "orders:expire": "tsx --env-file=.env scripts/expire-orders.ts",
    "orders:worker": "tsx --env-file=.env scripts/expire-orders.ts --watch",
    "payments:simulate": "tsx --env-file=.env scripts/simulate-payment.ts",
    "mail:local": "tsx --env-file=.env scripts/local-mail.ts",
    "test": "tsx --test tests/*.test.ts",
    "license": "tsx scripts/license.ts",
    "db:permissions": "tsx --env-file=.env scripts/database-permissions.ts",
    "doctor": "tsx scripts/doctor.ts",
    "backup": "tsx scripts/backup.ts",
    "build:worker": "node scripts/build-worker.mjs",
    "release": "npm run build && npm run build:worker && node scripts/package-release.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "demo:images": "tsx scripts/seed-demo-catalog.ts --images"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "^16.0.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
