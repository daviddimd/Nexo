DATABASE_URL=postgresql://nexo:REPLACE_ME@127.0.0.1:5432/nexo
APP_ORIGIN=http://localhost:3000
# Operator-only commercial CLI connection. Keep separate from runtime deployment.
# NEXO_OPERATOR_DATABASE_URL=postgresql://nexo_operator:REPLACE_ME@127.0.0.1:5432/nexo
# Local simulator only. Always disabled by default and rejected in production.
NEXO_SIMULATOR_ENABLED=false
# Map each company UUID to a separate random secret of at least 32 bytes.
# Keep real secrets only in .env or a secret manager; never in source control.
NEXO_SIMULATOR_SECRETS={}
# Local-only mail outbox, encrypted at rest; never sends real email.
# Always blocked in production. Generate a random 32-byte key (64 hex chars).
NEXO_LOCAL_MAIL_ENABLED=false
NEXO_LOCAL_MAIL_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Integration tests MUST use a separate database. Test data is removed after tests.
# TEST_DATABASE_URL=postgresql://nexo:REPLACE_ME@127.0.0.1:5432/nexo_test

# Optional OWNER license status. Public keys only; keep signing keys off this server.
# NEXO_INSTALLATION_FILE=C:/nexo-config/installation.json
# NEXO_LICENSE_TRUSTED_KEYS_FILE=C:/nexo-config/public-keys.json

# Maintenance only: separate schema-owner connection, never exposed to web runtime.
# NEXO_MIGRATION_DATABASE_URL=postgresql://nexo_migrator:REPLACE_ME@127.0.0.1:5432/nexo
# NEXO_DATABASE_SCHEMA=public
# NEXO_RUNTIME_ROLE=nexo_web
# NEXO_OPERATOR_ROLE=nexo_operator

# Backup/recovery administration only. Never expose these credentials to the web.
# NEXO_BACKUP_DATABASE_URL=postgresql://nexo_backup:REPLACE_ME@127.0.0.1:5432/nexo
# NEXO_RESTORE_DATABASE_URL=postgresql://nexo_restore:REPLACE_ME@127.0.0.1:5432/nexo_restore_test
# NEXO_PG_BIN=C:/Program Files/PostgreSQL/18/bin
